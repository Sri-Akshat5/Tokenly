# Copy this file to .env and fill in real values before running `docker compose up`.

########################################
# MySQL
########################################
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=tokenly_db
MYSQL_USER=tokenly
MYSQL_PASSWORD=tokenly_password
MYSQL_PORT=3306

########################################
# Redis
########################################
REDIS_PORT=6379

########################################
# Backend
########################################
BACKEND_PORT=8084
# Generate with: openssl rand -hex 32
JWT_SECRET=YOUR_LONG_JWT_SECRET_KEY_GOES_HERE_at_least_256_bits
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
BACKEND_URL=http://localhost:8084
FRONTEND_URL=http://localhost:5173

########################################
# Frontend
########################################
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8084
