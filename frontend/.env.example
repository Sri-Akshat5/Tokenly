# Tokenly Frontend Environment Variables
# Copy this file to .env and update with your values

# API Configuration
VITE_API_BASE_URL=http://localhost:8084
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=Tokenly
VITE_APP_DESCRIPTION=Authentication as a Service Platform

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Branding
VITE_FOOTER_TEXT=Tokenly
VITE_SECURED_BY_TEXT=Secured by Tokenly
